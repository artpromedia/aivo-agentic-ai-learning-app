{
  "name": "aivo-learning",
  "version": "1.0.0",
  "private": true,
  "description": "Special education platform with personalized AI models for neurodiverse children",
  "engines": {
    "node": ">=20.19.4",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:rbac": "playwright test e2e/rbac.spec.ts",
    "test:e2e:static-buttons": "playwright test e2e/static-buttons.spec.ts",
    "test:a11y": "playwright test --grep @a11y",
    "e2e:install": "playwright install --with-deps",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@react-native-community/cli-platform-android": "^15.1.3",
    "@react-native/gradle-plugin": "^0.82.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.22",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^20.0.7",
    "jsdom": "^27.0.1",
    "msw": "^2.11.6",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.4"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.2.0",
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.0.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "@types/react": "19",
        "eslint": "9",
        "react-native": "0.73"
      },
      "ignoreMissing": [
        "react-dom"
      ],
      "allowAny": [
        "@react-native-async-storage/async-storage"
      ]
    },
    "allowedDeprecatedVersions": {
      "react-native-vector-icons": "*",
      "@babel/plugin-proposal-class-properties": "*",
      "@babel/plugin-proposal-nullish-coalescing-operator": "*",
      "@babel/plugin-proposal-optional-chaining": "*",
      "@babel/plugin-proposal-async-generator-functions": "*",
      "@babel/plugin-proposal-numeric-separator": "*",
      "@babel/plugin-proposal-object-rest-spread": "*",
      "@babel/plugin-proposal-optional-catch-binding": "*",
      "glob": "*",
      "inflight": "*",
      "rimraf": "*",
      "source-map": "*",
      "source-map@0.8.0-beta.0": "*",
      "sourcemap-codec": "*",
      "sudo-prompt": "*"
    }
  },
  "packageManager": "pnpm@10.0.0"
}
