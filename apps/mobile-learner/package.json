{
  "name": "@aivo/mobile-learner",
  "version": "1.0.0",
  "description": "Aivo Learning - Mobile App for Neurodiverse Learners",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "pods": "cd ios && pod install && cd ..",
    "clean": "cd android && ./gradlew clean && cd .. && cd ios && xcodebuild clean && cd ..",
    "clean:cache": "rm -rf node_modules && rm -rf ios/build && rm -rf android/build && rm -rf android/app/build && watchman watch-del-all && react-native start --reset-cache"
  },
  "dependencies": {
    "@aivo/types": "workspace:*",
    "@nozbe/watermelondb": "^0.27.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "^5.1.0",
    "@react-native-firebase/analytics": "^23.4.1",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@tanstack/react-query": "^5.90.7",
    "axios": "^1.12.2",
    "nativewind": "^5.0.0-preview.2",
    "react": "18.2.0",
    "react-native": "0.73.9",
    "react-native-background-fetch": "^4.2.8",
    "react-native-background-upload": "^6.6.0",
    "react-native-device-info": "^14.1.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.29.0",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-image-picker": "^7.2.3",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "^4.18.0",
    "react-native-svg": "^15.14.0",
    "react-native-tts": "^4.1.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.17.0",
    "react-native-view-shot": "^4.0.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/runtime": "^7.28.4",
    "@react-native-community/cli": "^15.1.3",
    "@react-native-community/cli-platform-android": "^15.1.3",
    "@react-native-community/cli-platform-ios": "^15.1.3",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.38.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}
