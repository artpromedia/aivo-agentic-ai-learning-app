{
  "name": "@aivo/mobile-learner",
  "version": "1.0.0",
  "description": "Aivo Learning - Mobile App for Neurodiverse Learners",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "pods": "cd ios && pod install && cd ..",
    "clean": "cd android && ./gradlew clean && cd .. && cd ios && xcodebuild clean && cd ..",
    "clean:cache": "rm -rf node_modules && rm -rf ios/build && rm -rf android/build && rm -rf android/app/build && watchman watch-del-all && react-native start --reset-cache"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-native": "0.76.5",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/stack": "^6.4.1",
    "react-native-screens": "^4.4.0",
    "react-native-safe-area-context": "^4.14.0",
    "react-native-gesture-handler": "^2.20.2",
    "zustand": "^5.0.2",
    "@tanstack/react-query": "^5.62.7",
    "axios": "^1.7.9",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-paper": "^5.12.5",
    "react-native-vector-icons": "^10.2.0",
    "react-native-svg": "^15.8.0",
    "nativewind": "^4.1.23",
    "react-native-tts": "^4.1.0",
    "@react-native-voice/voice": "^3.2.4",
    "react-native-image-picker": "^7.1.2",
    "react-native-video": "^6.7.3",
    "@nozbe/watermelondb": "^0.27.1",
    "react-native-fs": "^2.20.0",
    "@aivo/types": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/react": "^19.0.6",
    "@types/react-test-renderer": "^19.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.6.2",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}
