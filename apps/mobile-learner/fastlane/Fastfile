# Fastlane Configuration for AIVO Learning Mobile App

# This is the minimum version number required.
fastlane_version "2.220.0"

default_platform(:ios)

# ============================================
# iOS Lanes
# ============================================

platform :ios do
  before_all do
    setup_ci if ENV['CI']
  end

  desc "Build iOS app for testing"
  lane :build do
    gym(
      scheme: "AivoLearner",
      workspace: "./ios/AivoLearner.xcworkspace",
      export_method: "development",
      clean: true
    )
  end

  desc "Run iOS tests"
  lane :test do
    run_tests(
      scheme: "AivoLearner",
      workspace: "./ios/AivoLearner.xcworkspace",
      devices: ["iPhone 15 Pro"],
      clean: true
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Ensure we're on a clean state
    ensure_git_status_clean

    # Increment build number
    increment_build_number(
      xcodeproj: "./ios/AivoLearner.xcodeproj"
    )

    # Build the app
    gym(
      scheme: "AivoLearner",
      workspace: "./ios/AivoLearner.xcworkspace",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "AivoLearner.ipa"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      apple_id: ENV["APPLE_ID"],
      app_identifier: "com.aivolearning.learner",
      itc_provider: ENV["ITC_PROVIDER"]
    )

    # Commit version bump
    commit_version_bump(
      message: "Bump iOS build number [skip ci]",
      xcodeproj: "./ios/AivoLearner.xcodeproj"
    )

    # Send notification
    if ENV["SLACK_WEBHOOK_URL"]
      slack(
        message: "🎉 New iOS beta uploaded to TestFlight!",
        success: true,
        slack_url: ENV["SLACK_WEBHOOK_URL"],
        default_payloads: [:git_branch, :git_author],
        attachment_properties: {
          fields: [
            {
              title: "Version",
              value: get_version_number(xcodeproj: "./ios/AivoLearner.xcodeproj"),
              short: true
            },
            {
              title: "Build",
              value: get_build_number(xcodeproj: "./ios/AivoLearner.xcodeproj"),
              short: true
            }
          ]
        }
      )
    end
  end

  desc "Deploy to App Store"
  lane :release do
    # Ensure we're on main branch
    ensure_git_branch(branch: 'main')
    ensure_git_status_clean

    # Increment version number (minor version)
    increment_version_number(
      bump_type: "minor",
      xcodeproj: "./ios/AivoLearner.xcodeproj"
    )

    # Increment build number
    increment_build_number(
      xcodeproj: "./ios/AivoLearner.xcodeproj"
    )

    # Build the app
    gym(
      scheme: "AivoLearner",
      workspace: "./ios/AivoLearner.xcworkspace",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "AivoLearner.ipa"
    )

    # Upload to App Store
    upload_to_app_store(
      force: true,
      submit_for_review: false,
      automatic_release: false,
      skip_metadata: false,
      skip_screenshots: false,
      precheck_include_in_app_purchases: false
    )

    # Commit version bump
    commit_version_bump(
      message: "Bump iOS version [skip ci]",
      xcodeproj: "./ios/AivoLearner.xcodeproj"
    )

    # Create git tag
    add_git_tag(
      tag: "v#{get_version_number(xcodeproj: './ios/AivoLearner.xcodeproj')}-ios"
    )

    # Push to remote
    push_to_git_remote

    # Send notification
    if ENV["SLACK_WEBHOOK_URL"]
      slack(
        message: "🚀 New iOS version released to App Store!",
        success: true,
        slack_url: ENV["SLACK_WEBHOOK_URL"],
        default_payloads: [:git_branch, :git_author],
        attachment_properties: {
          fields: [
            {
              title: "Version",
              value: get_version_number(xcodeproj: "./ios/AivoLearner.xcodeproj"),
              short: true
            },
            {
              title: "Build",
              value: get_build_number(xcodeproj: "./ios/AivoLearner.xcodeproj"),
              short: true
            }
          ]
        }
      )
    end
  end

  desc "Take screenshots for App Store"
  lane :screenshots do
    capture_screenshots(
      scheme: "AivoLearner",
      output_directory: "./fastlane/screenshots"
    )
  end

  error do |lane, exception|
    if ENV["SLACK_WEBHOOK_URL"]
      slack(
        message: "❌ iOS #{lane} failed!",
        success: false,
        slack_url: ENV["SLACK_WEBHOOK_URL"],
        attachment_properties: {
          fields: [
            {
              title: "Error",
              value: exception.to_s,
              short: false
            }
          ]
        }
      )
    end
  end
end

# ============================================
# Android Lanes
# ============================================

platform :android do
  before_all do
    setup_ci if ENV['CI']
  end

  desc "Build Android app for testing"
  lane :build do
    gradle(
      task: "clean assemble",
      build_type: "Debug",
      project_dir: "./android"
    )
  end

  desc "Run Android tests"
  lane :test do
    gradle(
      task: "test",
      project_dir: "./android"
    )
  end

  desc "Build and upload to Play Store Beta"
  lane :beta do
    # Ensure we're on a clean state
    ensure_git_status_clean

    # Increment version code
    android_set_version_code(
      gradle_file: "./android/app/build.gradle",
      version_code: (android_get_version_code(gradle_file: "./android/app/build.gradle") + 1)
    )

    # Build release bundle
    gradle(
      task: "clean bundleRelease",
      project_dir: "./android",
      print_command: false,
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_FILE"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"],
      }
    )

    # Upload to Play Store Beta track
    upload_to_play_store(
      track: 'beta',
      release_status: 'draft',
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # Commit version bump
    git_commit(
      path: "./android/app/build.gradle",
      message: "Bump Android version code [skip ci]"
    )

    # Send notification
    if ENV["SLACK_WEBHOOK_URL"]
      slack(
        message: "🎉 New Android beta uploaded to Play Store!",
        success: true,
        slack_url: ENV["SLACK_WEBHOOK_URL"],
        default_payloads: [:git_branch, :git_author],
        attachment_properties: {
          fields: [
            {
              title: "Version",
              value: android_get_version_name(gradle_file: "./android/app/build.gradle"),
              short: true
            },
            {
              title: "Build",
              value: android_get_version_code(gradle_file: "./android/app/build.gradle").to_s,
              short: true
            }
          ]
        }
      )
    end
  end

  desc "Deploy to Play Store"
  lane :release do
    # Ensure we're on main branch
    ensure_git_branch(branch: 'main')
    ensure_git_status_clean

    # Increment version name (minor version)
    current_version = android_get_version_name(gradle_file: "./android/app/build.gradle")
    version_parts = current_version.split('.')
    version_parts[1] = (version_parts[1].to_i + 1).to_s
    new_version = version_parts.join('.')

    android_set_version_name(
      gradle_file: "./android/app/build.gradle",
      version_name: new_version
    )

    # Increment version code
    android_set_version_code(
      gradle_file: "./android/app/build.gradle",
      version_code: (android_get_version_code(gradle_file: "./android/app/build.gradle") + 1)
    )

    # Build release bundle
    gradle(
      task: "clean bundleRelease",
      project_dir: "./android",
      print_command: false,
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_FILE"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"],
      }
    )

    # Upload to Play Store production track
    upload_to_play_store(
      track: 'production',
      release_status: 'draft',
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )

    # Commit version bump
    git_commit(
      path: "./android/app/build.gradle",
      message: "Bump Android version [skip ci]"
    )

    # Create git tag
    add_git_tag(
      tag: "v#{new_version}-android"
    )

    # Push to remote
    push_to_git_remote

    # Send notification
    if ENV["SLACK_WEBHOOK_URL"]
      slack(
        message: "🚀 New Android version released to Play Store!",
        success: true,
        slack_url: ENV["SLACK_WEBHOOK_URL"],
        default_payloads: [:git_branch, :git_author],
        attachment_properties: {
          fields: [
            {
              title: "Version",
              value: new_version,
              short: true
            },
            {
              title: "Build",
              value: android_get_version_code(gradle_file: "./android/app/build.gradle").to_s,
              short: true
            }
          ]
        }
      )
    end
  end

  desc "Take screenshots for Play Store"
  lane :screenshots do
    gradle(
      task: "assembleDebug assembleAndroidTest",
      project_dir: "./android"
    )
    
    capture_android_screenshots(
      app_apk_path: "./android/app/build/outputs/apk/debug/app-debug.apk"
    )
  end

  error do |lane, exception|
    if ENV["SLACK_WEBHOOK_URL"]
      slack(
        message: "❌ Android #{lane} failed!",
        success: false,
        slack_url: ENV["SLACK_WEBHOOK_URL"],
        attachment_properties: {
          fields: [
            {
              title: "Error",
              value: exception.to_s,
              short: false
            }
          ]
        }
      )
    end
  end
end
