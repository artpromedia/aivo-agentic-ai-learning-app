# Supabase Edge Functions Environment Variables
# Copy this file to supabase/.env and fill in your values

# OpenAI API Key for Whisper transcription
OPENAI_API_KEY=sk-your-openai-api-key-here

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (has full access - keep secure!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: These environment variables are automatically available in Edge Functions
# when deployed to Supabase. For local development, ensure they are set in
# supabase/.env file.
