# =================================================================
# AIVO AI LEARNING PLATFORM - ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# -----------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------
# Main PostgreSQL database for application data
DB_USER=aivo_user
DB_PASSWORD=aivo_dev_password
DB_NAME=aivo_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Curriculum Database (Separate DB for K-12 standards, lesson plans, assessments)
CURRICULUM_DB_NAME=aivo_curriculum
CURRICULUM_DB_PORT=5433
CURRICULUM_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${CURRICULUM_DB_PORT}/${CURRICULUM_DB_NAME}

# -----------------------------------------------------------------
# REDIS CACHE CONFIGURATION
# -----------------------------------------------------------------
# Used for session management, rate limiting, and caching
REDIS_PASSWORD=aivo_redis_dev
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
REDIS_MAX_CONNECTIONS=50

# -----------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------
# Generate a secure random string for production: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------
# AI PROVIDER API KEYS
# -----------------------------------------------------------------
# OpenAI (GPT-4, GPT-3.5, Embeddings)
OPENAI_API_KEY=sk-proj-...

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini Pro, Gemini Flash)
GOOGLE_API_KEY=AIza...

# Cohere (Command, Embed)
COHERE_API_KEY=...

# Mistral AI (Mistral Large, Mistral Medium)
MISTRAL_API_KEY=...

# Hugging Face (Open source models)
HUGGINGFACE_API_KEY=hf_...

# Default AI provider (openai, anthropic, google, cohere, mistral)
DEFAULT_AI_PROVIDER=openai

# -----------------------------------------------------------------
# SERVICE URLs (Microservices Communication)
# -----------------------------------------------------------------
# API Gateway - Main entry point for all API requests
API_GATEWAY_URL=http://localhost:8000

# Auth Service - Authentication and authorization
AUTH_SERVICE_URL=http://localhost:8001

# AI Inference Service - AI model serving and inference
AI_INFERENCE_SERVICE_URL=http://localhost:8002

# Curriculum Service - K-12 standards and lesson management
CURRICULUM_SERVICE_URL=http://localhost:8003

# Training Service - Model fine-tuning and training
TRAINING_SERVICE_URL=http://localhost:8004

# -----------------------------------------------------------------
# FRONTEND APP URLs
# -----------------------------------------------------------------
# Marketing and landing page
WEB_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Parent portal for guardians
PARENT_PORTAL_URL=http://localhost:5174

# Teacher portal for educators
TEACHER_PORTAL_URL=http://localhost:5175

# Learner app for students
LEARNER_APP_URL=http://localhost:5176

# District admin portal
DISTRICT_PORTAL_URL=http://localhost:5177

# Super admin portal (operations)
ADMIN_PORTAL_URL=http://localhost:5178

# -----------------------------------------------------------------
# EMAIL SERVICE (SendGrid/SMTP)
# -----------------------------------------------------------------
# SMTP server configuration for transactional emails
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxx
FROM_EMAIL=noreply@aivolearning.com
FROM_NAME=Aivo Learning
VITE_SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@aivolearning.com

# Email templates
EMAIL_VERIFICATION_TEMPLATE_ID=d-xxx
PASSWORD_RESET_TEMPLATE_ID=d-xxx
WELCOME_EMAIL_TEMPLATE_ID=d-xxx

# -----------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development
NODE_ENV=development

# Enable debug mode (verbose logging, detailed errors)
DEBUG=true
VITE_DEV_TOOLS=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# -----------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------
# Enable multi-factor authentication
ENABLE_MFA=false

# Require email verification for new accounts
ENABLE_EMAIL_VERIFICATION=true

# Enable AI model training/fine-tuning features
ENABLE_AI_TRAINING=false

# Enable scheduled assessments
ENABLE_ASSESSMENT_SCHEDULER=true

# Enable real-time collaboration features
ENABLE_REALTIME_COLLAB=false

# Enable analytics and telemetry
ENABLE_ANALYTICS=true
VITE_ENABLE_ANALYTICS=false

# PWA features
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true

# -----------------------------------------------------------------
# FILE UPLOAD
# -----------------------------------------------------------------
# Maximum file upload size in bytes (10MB default)
MAX_UPLOAD_SIZE=10485760

# Upload directory path
UPLOAD_DIR=/app/uploads

# Allowed file extensions for uploads
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.png,.jpg,.jpeg,.gif,.mp4,.mp3

# -----------------------------------------------------------------
# SESSION CONFIGURATION
# -----------------------------------------------------------------
# Session timeout in seconds (30 minutes default)
SESSION_TIMEOUT=1800

# Maximum concurrent sessions per user
MAX_SESSIONS_PER_USER=5

# -----------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------
# API rate limit (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Authentication rate limit (login attempts per hour)
AUTH_RATE_LIMIT_PER_HOUR=10

# -----------------------------------------------------------------
# MONITORING & OBSERVABILITY (Optional)
# -----------------------------------------------------------------
# Sentry error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Application Insights (Azure)
APPINSIGHTS_INSTRUMENTATION_KEY=

# DataDog APM
DATADOG_API_KEY=
DD_API_KEY=
DD_APP_KEY=

# -----------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# -----------------------------------------------------------------
# Stripe payment processing
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio (SMS/Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS S3 for file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=aivo-uploads
AWS_REGION=us-east-1

# Google Cloud AI
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Azure AD)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# -----------------------------------------------------------------
# DEVELOPMENT TOOLS
# -----------------------------------------------------------------
# Enable API documentation (Swagger/OpenAPI)
ENABLE_API_DOCS=true

# Enable GraphQL Playground
ENABLE_GRAPHQL_PLAYGROUND=true

# Database query logging
DB_ECHO=false

# -----------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------
# Password requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_UPPERCASE=true
REQUIRE_PASSWORD_LOWERCASE=true
REQUIRE_PASSWORD_NUMBERS=true
REQUIRE_PASSWORD_SPECIAL_CHARS=true

# Session security
SECURE_COOKIES=false  # Set to true in production with HTTPS
HTTPONLY_COOKIES=true
SAMESITE_COOKIES=lax

# -----------------------------------------------------------------
# AI MODEL CONFIGURATION
# -----------------------------------------------------------------
# Default model settings
DEFAULT_MODEL_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TOP_P=0.9

# Model selection per feature
LESSON_GENERATION_MODEL=gpt-4-turbo
ASSESSMENT_GRADING_MODEL=claude-3-5-sonnet
CHAT_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------
# LICENSING CONFIGURATION
# -----------------------------------------------------------------
# License code format (6 characters: ABC123)
LICENSE_CODE_LENGTH=6
LICENSE_CODE_PREFIX=

# Default license validity (days)
DEFAULT_LICENSE_VALIDITY_DAYS=365

# Seat allocation limits
MAX_SEATS_PER_LICENSE=100
DEFAULT_SEATS_PER_LICENSE=30
