# AIVO API Gateway Environment Configuration - EXAMPLE
# Copy this file to .env and fill in your actual values

# =============================================================================
# AI PROVIDER API KEYS - Configure for Baseline Assessment AI Features
# =============================================================================
# The baseline assessment uses a multi-provider fallback system:
# 1. OpenAI (primary) → 2. Anthropic → 3. Google Gemini → 4. Mock (dev/testing)
#
# Add your real API keys below. At least one is required for production.
# For development/testing, you can use USE_MOCK_AI=true to skip AI calls.

# OpenAI (Primary Provider)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic Claude
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy-your-google-key-here

# Optional: Force a specific provider for testing
# Uncomment ONE of these to test that specific provider:
# PRIMARY_AI_PROVIDER=openai
# PRIMARY_AI_PROVIDER=anthropic
# PRIMARY_AI_PROVIDER=gemini

# Optional: Use mock AI for development (no API keys needed)
# USE_MOCK_AI=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (Development)
DATABASE_URL=sqlite:///C:/aivo-agentic-ai-learning-app/services/api-gateway/aivo.db

# PostgreSQL (Production - recommended)
# DATABASE_URL=postgresql://aivo_user:password@localhost:5432/aivo_db

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching/sessions)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=aivo-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:5173"]

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_V1_STR=/api/v1
PROJECT_NAME=AIVO AI Learning Platform API
VERSION=1.0.0
