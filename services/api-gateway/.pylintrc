[MASTER]
# Add alembic to extension package whitelist
extension-pkg-whitelist=alembic.context

[MESSAGES CONTROL]
# Disable specific warnings that are false positives
disable=
    # Alembic context has dynamic attributes
    no-member,
    # Import errors handled by path modification
    import-error,
    # Unused imports in alembic/env.py are necessary for SQLAlchemy
    unused-import,
    # Wrong import position is intentional after path modification
    wrong-import-position,
    # Missing docstrings for generated files
    missing-module-docstring

[TYPECHECK]
# Generated members for dynamic modules
generated-members=alembic.context.*

[DESIGN]
# Ignore too many arguments, locals, etc for FastAPI routes
max-args=10
max-locals=20
