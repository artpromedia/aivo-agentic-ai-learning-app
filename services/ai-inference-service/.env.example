# AI Inference Service Configuration

# Application
PROJECT_NAME="AIVO AI Inference Service"
VERSION="1.0.0"
DEBUG=false

# Model Configuration
BASE_MODEL_NAME="gpt-4-turbo"
BASE_MODEL_VERSION="1.0.0"
MODEL_CACHE_DIR="/app/models"

# Brain Cloning
ENABLE_BRAIN_CLONING=true
MAX_BRAIN_INSTANCES=1000
BRAIN_SYNC_INTERVAL=3600
FEDERATED_LEARNING_ENABLED=true

# Inference
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096
MAX_CONTEXT_LENGTH=128000
BATCH_SIZE=8

# Performance
USE_GPU=false
GPU_MEMORY_FRACTION=0.8
NUM_WORKERS=4

# Redis (for brain state caching)
REDIS_URL="redis://localhost:6379/2"
BRAIN_CACHE_TTL=3600

# Special Education Features
HINT_COMPLEXITY_LEVELS=["simple", "moderate", "detailed"]
EXPLANATION_MAX_LENGTH=500
ADAPTIVE_DIFFICULTY=true

# OpenAI API (primary)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_ORG_ID=""

# Anthropic API (alternative)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
