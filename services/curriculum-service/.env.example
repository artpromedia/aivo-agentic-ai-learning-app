# Curriculum Service Environment Variables

# Service Configuration
SERVICE_NAME=curriculum-service
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivo_curriculum
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/2

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NCES_API_KEY=your_nces_api_key_here

# Data Sources
COMMON_CORE_API_URL=http://www.corestandards.org/wp-json/ccss
NGSS_API_URL=https://www.nextgenscience.org/api

# File Paths
CURRICULUM_DATA_PATH=./data/curriculum
TRAINING_DATA_PATH=./data/training
MODEL_ARTIFACTS_PATH=./data/models

# Import Settings
BATCH_SIZE=100
MAX_CONCURRENT_IMPORTS=5
IMPORT_TIMEOUT_SECONDS=300

# Training Settings
BASE_MODEL_PROVIDER=openai
BASE_MODEL_NAME=gpt-4-turbo-preview
TRAINING_BATCH_SIZE=32
TRAINING_EPOCHS=3

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
