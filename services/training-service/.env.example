# Training Service Environment Variables

# Service Configuration
SERVICE_NAME=training-service
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO

# Database (shared with curriculum service)
CURRICULUM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivo_curriculum

# Redis
REDIS_URL=redis://localhost:6379/3

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Training Configuration
TRAINING_CONFIG_PATH=config/training_config.yaml
MODELS_PATH=./models
TRAINING_DATA_PATH=./data/training
CHECKPOINTS_PATH=./data/checkpoints

# Training Resources
MAX_CONCURRENT_TRAINING_JOBS=2
TRAINING_TIMEOUT_HOURS=48

# Monitoring (optional)
WANDB_API_KEY=your_wandb_key_here
MLFLOW_TRACKING_URI=http://localhost:5000

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
