# ========================================
# AIVO BACKEND - ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to git!

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_USER=aivo_user
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DB_NAME=aivo_db
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://aivo_user:CHANGE_ME_TO_SECURE_PASSWORD@postgres:5432/aivo_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME_TO_SECURE_REDIS_PASSWORD@redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ========================================
# SECURITY & AUTHENTICATION
# ========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARACTER_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# ========================================
# API GATEWAY CONFIGURATION
# ========================================
API_V1_STR=/api/v1
PROJECT_NAME=AIVO AI Learning Platform API
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
WORKERS=4

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:5005,http://localhost:5009
CORS_ALLOW_CREDENTIALS=true

# ========================================
# AI MODEL CONFIGURATION
# ========================================
AI_MODEL_NAME=gpt-4-turbo
OPENAI_API_KEY=CHANGE_ME_TO_YOUR_OPENAI_API_KEY
MAX_CONTEXT_LENGTH=128000
TEMPERATURE=0.7
MAX_TOKENS=4096

# ========================================
# FILE UPLOAD
# ========================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,txt,jpg,jpeg,png

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ========================================
# SERVICE URLS
# ========================================
AUTH_SERVICE_URL=http://auth-service:8001
AI_SERVICE_URL=http://ai-inference-service:8002
